# Public site URL, used for canonical and OG URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.marioxsoftware.com

# Backend that serves the /[serviceCity] SEO landing pages (GET /homeScreen/:slug)
NEXT_PUBLIC_BASE_API_URL=

# Backend that stores enquiries (POST /user/inquires)
NEXT_PUBLIC_BASE_INQUIRES_API_URL=

# Legacy page API (src/lib/api.js)
API_URL=

# SMTP for /api/contact (team notification + acknowledgement to the sender)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
TO_EMAIL=
